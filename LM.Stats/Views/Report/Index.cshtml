@{
    ViewData["Title"] = "Weekly Report";
}

<style>
    .filter-dropdown-menu {
        max-height: 340px;
        overflow-y: auto;
        min-width: 100%;
        overflow-x: hidden;
    }

    .filter-chip {
        display: inline-block;
        margin-right: 4px;
        margin-bottom: 2px;
    }
    .filter-dropdown-menu .form-check {
        border-radius: 4px;
        padding: 2px 4px 2px 1.75rem;
        transition: box-shadow 0.15s ease;
    }

    .filter-dropdown-menu .form-check-input {
        margin-left: -1.25rem;
    }

    .filter-dropdown-menu .form-check:hover {
        background-color: transparent !important;
        box-shadow: inset 0 0 0 1px rgba(13, 110, 253, 0.25);
    }
    .report-theme .report-controls {
        background: #ffffff;
        border: 1px solid #dbe4f0;
    }

    .report-theme .filter-toggle-btn {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #334155;
    }

    .report-theme .filter-toggle-btn:hover,
    .report-theme .filter-toggle-btn:focus {
        background: #f8fafc;
        border-color: #93c5fd;
        color: #1e3a8a;
        box-shadow: none;
    }

    .report-theme #topPerformers .card-header {
        background-color: #0d6efd !important;
        color: #fff !important;
    }
    #reportTable .table tbody td {
        padding: 0.22rem 0.38rem;
        line-height: 1.1;
        vertical-align: middle;
    }

    #topPerformers .card-body {
        padding: 0.55rem 0.65rem;
    }
    .trend-up { color: #198754; font-weight: 600; }
    .trend-down { color: #dc3545; font-weight: 600; }
    .trend-flat { color: #6c757d; font-weight: 600; }
    .mini-sparkline svg { display:block; margin-top:3px; }
    #dataInsights .card { border: 1px solid #dbe4f0; }
    .sortable-header { cursor: pointer; user-select: none; }
    .reset-sort-header { cursor: pointer; user-select: none; }
    .player-link {
        background: transparent;
        border: 0;
        color: inherit;
        font: inherit;
        padding: 0;
        text-align: left;
    }
    .player-link:hover {
        cursor: pointer;
    }
    .dropdown-with-clear {
        position: relative;
    }
    .dropdown-with-clear .filter-toggle-btn {
        padding-right: 3.8rem;
    }
    .dropdown-clear-icon {
        position: absolute;
        right: 2.25rem;
        top: 50%;
        transform: translateY(-50%);
        width: 1.45rem;
        height: 1.45rem;
        border: 1px solid #d7dee9;
        border-radius: 999px;
        background: #f8fafc;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1;
        padding: 0;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }
    .dropdown-clear-icon:hover {
        color: #1e293b;
        border-color: #b8c4d6;
        background: #eef2f7;
    }
    .dropdown-clear-icon:focus-visible {
        outline: 0;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.2);
    }
    .dropdown-clear-icon::before {
        content: '\00D7';
    }
    .player-explorer-modal-dialog {
        max-width: 96vw;
    }
    .player-explorer-modal-content {
        height: 92vh;
    }
    .player-explorer-modal-body {
        padding: 0;
        overflow: hidden;
    }
    .player-explorer-frame {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }
    .editable-cell {
        cursor: text;
        position: relative;
    }
    .editable-cell.editing {
        padding: 0.12rem 0.24rem !important;
    }
    .inline-edit-input {
        width: 100%;
        min-width: 70px;
        border: 1px solid #93c5fd;
        border-radius: 0.4rem;
        padding: 0.18rem 0.42rem;
        font: inherit;
        line-height: 1.2;
        color: #1f2937;
        background: #fff;
        box-shadow: 0 0 0 0.12rem rgba(13, 110, 253, 0.14);
    }
    .inline-edit-input:focus {
        outline: none;
    }
    .report-nav-search {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .report-nav-search-wrap {
        width: 0;
        opacity: 0;
        overflow: hidden;
        transition: width 0.22s ease, opacity 0.22s ease;
    }
    .report-nav-search-wrap.open {
        width: 220px;
        opacity: 1;
    }
</style>

<div class="container mt-3 report-theme">
    <div class="report-controls mb-4 card p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <h6 class="mb-1">Report Date Range</h6>
                <select id="weekDropdown" class="form-select"></select>
            </div>

            <div class="col-md-4">
                <h6 class="mb-1">Player Status</h6>
                <div class="dropdown-with-clear">
                    <div class="dropdown">
                        <button id="statusDropdownBtn" class="btn filter-toggle-btn w-100 text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            Player Status
                        </button>
                        <div class="dropdown-menu p-2 w-100 filter-dropdown-menu">
                            <input type="text" class="form-control form-control-sm mb-2 dropdown-search" data-target=".status-filter-item" placeholder="Search..." />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="statusSelectAll" checked>
                                <label class="form-check-label" for="statusSelectAll">Select All</label>
                            </div>
                            <hr class="my-2" />
                            <div class="form-check status-filter-item"><input class="form-check-input status-filter" type="checkbox" id="statusCompletedBoth" checked><label class="form-check-label" for="statusCompletedBoth">Completed Both</label></div>
                            <div class="form-check status-filter-item"><input class="form-check-input status-filter" type="checkbox" id="statusCompletedOne" checked><label class="form-check-label" for="statusCompletedOne">Completed One</label></div>
                            <div class="form-check status-filter-item"><input class="form-check-input status-filter" type="checkbox" id="statusFailedBoth" checked><label class="form-check-label" for="statusFailedBoth">Failed Both</label></div>
                            <div class="form-check status-filter-item"><input class="form-check-input status-filter" type="checkbox" id="statusNewPlayers" checked><label class="form-check-label" for="statusNewPlayers">New Players</label></div>
                            <div class="form-check status-filter-item"><input class="form-check-input status-filter" type="checkbox" id="statusLeftPlayers" checked><label class="form-check-label" for="statusLeftPlayers">Left Players</label></div>
                        </div>
                    </div>
                    <button type="button" class="dropdown-clear-icon" title="Clear player status" aria-label="Clear player status" onclick="clearFilterGroup('status', event)"></button>
                </div>
            </div>

            <div class="col-md-4">
                <h6 class="mb-1">Report Headers</h6>
                <div class="dropdown-with-clear">
                    <div class="dropdown">
                        <button id="headersDropdownBtn" class="btn filter-toggle-btn w-100 text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            Report Headers
                        </button>
                        <div class="dropdown-menu p-2 w-100 filter-dropdown-menu">
                            <input type="text" class="form-control form-control-sm mb-2 dropdown-search" data-target=".header-filter-item" placeholder="Search..." />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="headerSelectAll" checked>
                                <label class="form-check-label" for="headerSelectAll">Select All</label>
                            </div>
                            <hr class="my-2" />
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerName" checked><label class="form-check-label" for="headerName">Name</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerKills" checked><label class="form-check-label" for="headerKills">Kills (%)</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerEDM" checked><label class="form-check-label" for="headerEDM">EDM</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerTroopsLost" checked><label class="form-check-label" for="headerTroopsLost">Troops Lost</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerHunt" checked><label class="form-check-label" for="headerHunt">Hunt (%)</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerPurchase" checked><label class="form-check-label" for="headerPurchase">Purchase</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerHistory" checked><label class="form-check-label" for="headerHistory">History</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerHistoryGraph" checked><label class="form-check-label" for="headerHistoryGraph">History Graph</label></div>
                            <div class="form-check header-filter-item"><input class="form-check-input header-filter" type="checkbox" id="headerHistoryIndicators" checked><label class="form-check-label" for="headerHistoryIndicators">History Indicators</label></div>
                        </div>
                    </div>
                    <button type="button" class="dropdown-clear-icon" title="Clear report headers" aria-label="Clear report headers" onclick="clearFilterGroup('headers', event)"></button>
                </div>
            </div>
        </div>

        <div class="row g-2 mt-1 align-items-end">
            <div class="col-md-4">
                <h6 class="mb-1">Summary Types</h6>
                <div class="dropdown-with-clear">
                    <div class="dropdown">
                        <button id="summaryDropdownBtn" class="btn filter-toggle-btn w-100 text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            Summary Types
                        </button>
                        <div class="dropdown-menu p-2 w-100 filter-dropdown-menu">
                            <input type="text" class="form-control form-control-sm mb-2 dropdown-search" data-target=".summary-filter-item" placeholder="Search..." />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="summarySelectAll" checked>
                                <label class="form-check-label" for="summarySelectAll">Select All</label>
                            </div>
                            <hr class="my-2" />
                            <div class="form-check summary-filter-item"><input class="form-check-input summary-filter" type="checkbox" id="summaryTopKills" data-summary="topKills" checked><label class="form-check-label" for="summaryTopKills">Top Kills</label></div>
                            <div class="form-check summary-filter-item"><input class="form-check-input summary-filter" type="checkbox" id="summaryTopHunt" data-summary="topHunt" checked><label class="form-check-label" for="summaryTopHunt">Top Hunt</label></div>
                            <div class="form-check summary-filter-item"><input class="form-check-input summary-filter" type="checkbox" id="summaryTopEDM" data-summary="topEDM" checked><label class="form-check-label" for="summaryTopEDM">Top EDM</label></div>
                            <div class="form-check summary-filter-item"><input class="form-check-input summary-filter" type="checkbox" id="summaryTopPurchase" data-summary="topPurchase" checked><label class="form-check-label" for="summaryTopPurchase">Top Purchase</label></div>
                            <div class="form-check summary-filter-item"><input class="form-check-input summary-filter" type="checkbox" id="summaryDataInsights" data-summary="dataInsights" checked><label class="form-check-label" for="summaryDataInsights">Total Stats</label></div>
                        </div>
                    </div>
                    <button type="button" class="dropdown-clear-icon" title="Clear summary types" aria-label="Clear summary types" onclick="clearFilterGroup('summary', event)"></button>
                </div>
            </div>

            <div class="col-md-4">
                <h6 class="mb-1">Players to Ignore</h6>
                <div class="dropdown-with-clear">
                    <div class="dropdown">
                        <button id="ignorePlayersBtn" class="btn filter-toggle-btn w-100 text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            Ignore Players
                        </button>
                        <div class="dropdown-menu p-2 w-100 filter-dropdown-menu" id="ignorePlayersContainer">
                            <input type="text" class="form-control form-control-sm mb-2 dropdown-search" data-target=".ignore-player-item" placeholder="Search players..." />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ignoreSelectAll">
                                <label class="form-check-label" for="ignoreSelectAll">Select All</label>
                            </div>
                            <hr class="my-2" />
                            <div class="text-muted small">Generate report to load players</div>
                        </div>
                    </div>
                    <button type="button" class="dropdown-clear-icon" title="Clear ignored players" aria-label="Clear ignored players" onclick="clearFilterGroup('ignore', event)"></button>
                </div>
            </div>

            <div class="col-md-4 text-end">
                <button id="generateReportBtn" class="btn btn-primary me-2" onclick="generateReport()">Generate Report</button>
                <div id="exportGroup" class="btn-group me-2" style="display:none;">
                    <button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export as</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button id="pdfButton" class="dropdown-item" type="button" onclick="generatePDF()">PDF</button></li>
                        <li><button id="jpgButton" class="dropdown-item" type="button" onclick="generateJPG()">Image (JPG)</button></li>
                    </ul>
                </div>
                <button id="resetFiltersBtn" class="btn btn-outline-secondary d-none" onclick="resetFilters()">Reset Filters</button>
            </div>
        </div>
    </div>

    <div id="dataInsights" class="row g-3 mb-3"></div>
    <div id="reportTable" class="table-responsive mb-4"></div>
    <div id="topPerformers" class="row g-3 mb-4"></div>

    <div id="heatmapLegend" class="card p-3 mb-4">
        <div class="d-flex flex-wrap gap-3">
            <div class="d-flex align-items-center"><span class="heatmap-cell green me-2"></span> Green Zone (Completed Both)</div>
            <div class="d-flex align-items-center"><span class="heatmap-cell yellow me-2"></span> Yellow Zone (Completed One)</div>
            <div class="d-flex align-items-center"><span class="heatmap-cell red me-2"></span> Red Zone (Failed Both)</div>
            <div class="d-flex align-items-center"><span class="heatmap-cell new me-2"></span> New Player</div>
            <div class="d-flex align-items-center"><span class="heatmap-cell left me-2"></span> Left Player</div>
        </div>
    </div>
</div>

<div class="modal fade" id="playerExplorerModal" tabindex="-1" aria-labelledby="playerExplorerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered player-explorer-modal-dialog">
        <div class="modal-content player-explorer-modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="playerExplorerModalLabel">Player Explorer</h5>
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group" id="playerExplorerModalExportGroup" style="display:none;">
                        <button type="button" class="btn btn-danger btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button class="dropdown-item" type="button" onclick="exportPlayerModalPdf()">PDF</button></li>
                            <li><button class="dropdown-item" type="button" onclick="exportPlayerModalJpg()">Image (JPG)</button></li>
                            <li><button class="dropdown-item" type="button" onclick="printPlayerModal()">Print</button></li>
                        </ul>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body player-explorer-modal-body">
                <iframe id="playerExplorerFrame" class="player-explorer-frame" src="about:blank" title="Player Explorer"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.24/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        let allData = {};
        let currentWeek = '';
        let weeksToShow = [];
        let availableWeeks = [];
        let previousReportMap = new Map();
        let currentSort = { key: 'history', direction: 'asc' };
        let pageBindingsInitialized = false;
        let playerExplorerModalInstance = null;
        let reportSearchTerm = '';
        let activeInlineEditCell = null;

        function getPlayerExplorerFrameWindow() {
            const frameEl = document.getElementById('playerExplorerFrame');
            if (!frameEl) return null;
            return frameEl.contentWindow || null;
        }

        function withExplorerWindow(action) {
            const win = getPlayerExplorerFrameWindow();
            if (!win) return;
            action(win);
        }

        function exportPlayerModalPdf() {
            withExplorerWindow((win) => {
                if (typeof win.exportPlayerPdf === 'function') {
                    win.exportPlayerPdf();
                }
            });
        }

        function exportPlayerModalJpg() {
            withExplorerWindow((win) => {
                if (typeof win.exportPlayerJpg === 'function') {
                    win.exportPlayerJpg();
                }
            });
        }

        function printPlayerModal() {
            withExplorerWindow((win) => {
                win.focus();
                win.print();
            });
        }

        const summaryCategories = [
            { key: 'topKills', title: 'Top Kills', valueField: 'killsDiff', suffix: 'kills' },
            { key: 'topHunt', title: 'Top Hunt', valueField: 'huntPoints', suffix: 'pts' },
            { key: 'topEDM', title: 'Top EDM', valueField: 'edmDiff', suffix: 'EDM' },
            { key: 'topPurchase', title: 'Top Purchase', valueField: 'purchasePoints', suffix: 'pts' }
        ];

        const FILTER_STATE_KEY = 'report.filters.v1';

        function getSavedState() {
            try {
                return JSON.parse(localStorage.getItem(FILTER_STATE_KEY) || '{}');
            } catch {
                return {};
            }
        }

        function saveState() {
            const payload = {
                week: document.getElementById('weekDropdown')?.value || '',
                status: Object.fromEntries(Array.from(document.querySelectorAll('.status-filter')).map(cb => [cb.id, cb.checked])),
                headers: Object.fromEntries(Array.from(document.querySelectorAll('.header-filter')).map(cb => [cb.id, cb.checked])),
                summary: Object.fromEntries(Array.from(document.querySelectorAll('.summary-filter')).map(cb => [cb.id, cb.checked])),
                ignoredPlayers: Array.from(document.querySelectorAll('.ignore-player-filter:checked')).map(cb => cb.value)
            };
            localStorage.setItem(FILTER_STATE_KEY, JSON.stringify(payload));
        }

        function applySavedStaticFilters() {
            const state = getSavedState();
            const apply = (obj) => {
                if (!obj) return;
                Object.entries(obj).forEach(([id, checked]) => {
                    const el = document.getElementById(id);
                    if (el) el.checked = !!checked;
                });
            };
            apply(state.status);
            apply(state.headers);
            apply(state.summary);
        }

        function refreshWeekDropdown(preferredWeek) {
            const dropdown = document.getElementById('weekDropdown');
            if (!dropdown) return Promise.resolve();

            return fetch('/Report/GetAvailableWeeks')
                .then(response => response.json())
                .then(weeks => {
                    availableWeeks = weeks || [];
                    const currentSelection = preferredWeek || dropdown.value || getSavedState().week || '';
                    dropdown.innerHTML = '';

                    weeks.forEach(week => {
                        const option = document.createElement('option');
                        option.value = week.uniqueIdentifier;
                        option.text = `${formatDate(week.fromDate)} - ${formatDate(week.toDate)}`;
                        dropdown.appendChild(option);
                    });

                    if (currentSelection && dropdown.querySelector("option[value='" + currentSelection + "']")) {
                        dropdown.value = currentSelection;
                    } else if (weeks.length > 0) {
                        dropdown.value = weeks[0].uniqueIdentifier;
                    }

                    currentWeek = dropdown.value || '';
                    saveState();
                });
        }

        window.refreshAvailableWeeks = refreshWeekDropdown;

        async function initializeReportPage(autoGenerate) {
            applySavedStaticFilters();
            await refreshWeekDropdown();

            if (!pageBindingsInitialized) {
                bindReportNavSearch();
                setupSelectAll('statusSelectAll', '.status-filter');
                setupSelectAll('headerSelectAll', '.header-filter');
                setupSelectAll('summarySelectAll', '.summary-filter');
                setupSearchHandlers();
                document.getElementById('weekDropdown')?.addEventListener('change', () => {
                    currentWeek = document.getElementById('weekDropdown')?.value || '';
                    saveState();
                    generateReport();
                });

                document.querySelectorAll('.status-filter, .header-filter, .summary-filter').forEach(cb => {
                    cb.addEventListener('change', () => {
                        if (cb.id === 'headerHistory') {
                            resetSort(false);
                        }
                        updateAllDropdownButtonTexts();
                        saveState();
                        if (allData && Object.keys(allData).length > 0) displayReport(allData);
                    });
                });

                pageBindingsInitialized = true;
            }

            updateAllDropdownButtonTexts();
            if (autoGenerate) {
                await generateReport();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initializeReportPage(true);
        });

        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                initializeReportPage(true);
            }
        });

        function setupSearchHandlers() {
            document.querySelectorAll('.dropdown-search').forEach(input => {
                input.addEventListener('input', function() {
                    const targetSelector = input.dataset.target;
                    const query = (input.value || '').toLowerCase();
                    document.querySelectorAll(targetSelector).forEach(item => {
                        const label = (item.textContent || '').toLowerCase();
                        item.style.display = label.includes(query) ? '' : 'none';
                    });
                });
            });
        }

        function bindInlineEditHandlers() {
            document.querySelectorAll('#reportTable td.editable-cell').forEach(cell => {
                if (cell.dataset.bound === '1') return;
                cell.dataset.bound = '1';
                cell.addEventListener('dblclick', () => beginInlineEdit(cell));
            });
        }

        function beginInlineEdit(cell) {
            if (!cell || cell.classList.contains('editing')) return;
            const field = cell.dataset.field;
            const userId = cell.dataset.userId;
            const rawValue = cell.dataset.rawValue ?? '';
            if (!field || !userId) return;

            if (activeInlineEditCell && activeInlineEditCell !== cell) {
                cancelInlineEdit(activeInlineEditCell);
            }

            activeInlineEditCell = cell;
            cell.classList.add('editing');
            cell.dataset.originalHtml = cell.innerHTML;
            cell.innerHTML = `<input type="text" class="inline-edit-input" value="${escapeHtml(rawValue)}" />`;

            const input = cell.querySelector('input');
            if (!input) return;

            input.focus();
            input.select();

            input.addEventListener('keydown', async (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    await saveInlineEdit(cell, input.value);
                }

                if (event.key === 'Escape') {
                    event.preventDefault();
                    cancelInlineEdit(cell);
                }
            });

            input.addEventListener('blur', () => {
                if (cell.classList.contains('editing')) {
                    cancelInlineEdit(cell);
                }
            });
        }

        function cancelInlineEdit(cell) {
            if (!cell) return;
            cell.classList.remove('editing');
            if (cell.dataset.originalHtml) {
                cell.innerHTML = cell.dataset.originalHtml;
                delete cell.dataset.originalHtml;
            }
            if (activeInlineEditCell === cell) {
                activeInlineEditCell = null;
            }
        }

        async function saveInlineEdit(cell, value) {
            const field = cell.dataset.field;
            const userId = Number(cell.dataset.userId || 0);
            if (!field || !userId || !currentWeek) {
                cancelInlineEdit(cell);
                return;
            }

            const trimmedValue = (value || '').trim();
            if (!trimmedValue.length) {
                cancelInlineEdit(cell);
                return;
            }

            try {
                const response = await fetch('/Report/UpdateReportValue', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        week: currentWeek,
                        userId,
                        field,
                        value: trimmedValue
                    })
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    window.alert(result.message || 'Failed to update value.');
                    cancelInlineEdit(cell);
                    return;
                }

                activeInlineEditCell = null;
                await generateReport();
            } catch {
                window.alert('Failed to update value.');
                cancelInlineEdit(cell);
            }
        }

        function bindReportNavSearch() {
            const toggle = document.getElementById('reportNavSearchToggle');
            const wrap = document.getElementById('reportNavSearchWrap');
            const input = document.getElementById('reportNavSearchInput');
            if (!toggle || !wrap || !input || toggle.dataset.bound === '1') return;

            toggle.dataset.bound = '1';

            toggle.addEventListener('click', function() {
                const isOpen = wrap.classList.toggle('open');
                if (isOpen) {
                    input.focus();
                } else {
                    input.value = '';
                    reportSearchTerm = '';
                    if (allData && Object.keys(allData).length > 0) {
                        displayReport(allData);
                    }
                }
            });

            input.addEventListener('input', function() {
                reportSearchTerm = (input.value || '').trim().toLowerCase();
                if (allData && Object.keys(allData).length > 0) {
                    displayReport(allData);
                }
            });

            input.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    wrap.classList.remove('open');
                    input.value = '';
                    reportSearchTerm = '';
                    if (allData && Object.keys(allData).length > 0) {
                        displayReport(allData);
                    }
                }
            });
        }

        function setupSelectAll(selectAllId, itemSelector) {
            const selectAll = document.getElementById(selectAllId);
            if (!selectAll) return;

            selectAll.addEventListener('change', function() {
                document.querySelectorAll(itemSelector).forEach(cb => cb.checked = selectAll.checked);
                updateAllDropdownButtonTexts();
                saveState();
                if (allData && Object.keys(allData).length > 0) displayReport(allData);
            });

            document.querySelectorAll(itemSelector).forEach(cb => {
                cb.addEventListener('change', function() {
                    const items = Array.from(document.querySelectorAll(itemSelector));
                    selectAll.checked = items.length > 0 && items.every(i => i.checked);
                    saveState();
                });
            });
        }

        function updateDropdownButtonText(buttonId, checkedSelector, defaultText) {
            const btn = document.getElementById(buttonId);
            if (!btn) return;

            const checked = Array.from(document.querySelectorAll(checkedSelector));
            const labels = checked.map(c => c.nextElementSibling?.textContent?.trim()).filter(Boolean);

            if (labels.length === 0) {
                btn.textContent = `${defaultText} (None)`;
                return;
            }

            if (labels.length <= 3) {
                const chips = labels.map(l => `<span class="badge bg-secondary filter-chip">${l}</span>`).join('');
                btn.innerHTML = chips;
                return;
            }

            const chips = labels.slice(0, 3).map(l => `<span class="badge bg-secondary filter-chip">${l}</span>`).join('');
            btn.innerHTML = `${chips}<span class="badge bg-light text-dark filter-chip">+${labels.length - 3}</span>`;
        }

        function updateAllDropdownButtonTexts() {
            updateDropdownButtonText('statusDropdownBtn', '.status-filter:checked', 'Player Status');
            updateDropdownButtonText('headersDropdownBtn', '.header-filter:checked', 'Report Headers');
            updateDropdownButtonText('summaryDropdownBtn', '.summary-filter:checked', 'Summary Types');
            updateDropdownButtonText('ignorePlayersBtn', '.ignore-player-filter:checked', 'Ignore Players');
        }

        function setButtonLoading(buttonId, isLoading, loadingText, defaultText) {
            const btn = document.getElementById(buttonId);
            if (!btn) return;

            if (isLoading) {
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${loadingText}`;
            } else {
                btn.disabled = false;
                btn.innerHTML = defaultText;
                updateAllDropdownButtonTexts();
            }
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', { day: '2-digit', month: 'short' }).replace(',', '');
        }

        function getColumnVisibility() {
            return {
                name: document.getElementById('headerName').checked,
                kills: document.getElementById('headerKills').checked,
                edm: document.getElementById('headerEDM').checked,
                troopsLost: document.getElementById('headerTroopsLost').checked,
                hunt: document.getElementById('headerHunt').checked,
                purchase: document.getElementById('headerPurchase').checked,
                history: document.getElementById('headerHistory').checked,
                historyGraph: document.getElementById('headerHistoryGraph').checked,
                historyIndicators: document.getElementById('headerHistoryIndicators').checked
            };
        }

        function getSelectedSummaryCategories() {
            const selected = new Set();
            document.querySelectorAll('.summary-filter:checked').forEach(cb => selected.add(cb.dataset.summary));
            return summaryCategories.filter(c => selected.has(c.key));
        }

        function isDataInsightsEnabled() {
            return document.getElementById('summaryDataInsights')?.checked ?? true;
        }

        function getIgnoredPlayerSet() {
            const ignored = new Set();
            document.querySelectorAll('.ignore-player-filter:checked').forEach(cb => ignored.add((cb.value || '').toLowerCase()));
            return ignored;
        }

        function getAllPlayerRows() {
            return [...(allData.completedBoth || []), ...(allData.completedOne || []), ...(allData.failedBoth || []), ...(allData.recentlyJoined || []), ...(allData.leftPlayers || [])];
        }

        function clearFilterGroup(group, evt) {
            if (evt) {
                evt.preventDefault();
                evt.stopPropagation();
            }

            if (group === 'status') {
                document.querySelectorAll('.status-filter').forEach(cb => cb.checked = false);
                const all = document.getElementById('statusSelectAll');
                if (all) all.checked = false;
            }

            if (group === 'headers') {
                document.querySelectorAll('.header-filter').forEach(cb => cb.checked = false);
                const all = document.getElementById('headerSelectAll');
                if (all) all.checked = false;
            }

            if (group === 'summary') {
                document.querySelectorAll('.summary-filter').forEach(cb => cb.checked = false);
                const all = document.getElementById('summarySelectAll');
                if (all) all.checked = false;
            }

            if (group === 'ignore') {
                document.querySelectorAll('.ignore-player-filter').forEach(cb => cb.checked = false);
                const all = document.getElementById('ignoreSelectAll');
                if (all) all.checked = false;
            }

            updateAllDropdownButtonTexts();
            saveState();
            if (allData && Object.keys(allData).length > 0) {
                displayReport(allData);
            }
        }

        function resetSort(shouldRender) {
            currentSort = { key: 'history', direction: 'asc' };
            if (shouldRender && allData && Object.keys(allData).length > 0) {
                displayReport(allData);
            }
        }

        function getRowKey(row) {
            if (row && row.userId !== undefined && row.userId !== null) {
                return `id:${row.userId}`;
            }
            return `name:${(row?.name || '').toLowerCase()}`;
        }

        function buildPreviousReportMap(data) {
            previousReportMap = new Map();
            if (!data) return;

            const rows = [
                ...(data.completedBoth || []),
                ...(data.completedOne || []),
                ...(data.failedBoth || []),
                ...(data.recentlyJoined || []),
                ...(data.leftPlayers || [])
            ];

            rows.forEach(row => previousReportMap.set(getRowKey(row), row));
        }

        function sortIndicator(key) {
            if (currentSort.key !== key) return '';
            return currentSort.direction === 'asc' ? ' ^' : ' v';
        }

        function compareRows(a, b, key) {
            if (key === 'history') {
                const zoneOrder = { Green: 0, Yellow: 1, Red: 2, New: 3, Left: 4 };
                const av = zoneOrder[a.zone] ?? 99;
                const bv = zoneOrder[b.zone] ?? 99;
                if (av !== bv) return av - bv;
                return (a.name || '').localeCompare(b.name || '');
            }

            if (key === 'name') {
                return (a.name || '').localeCompare((b.name || ''));
            }

            const av = Number(a[key] || 0);
            const bv = Number(b[key] || 0);
            return av - bv;
        }

        function bindSortHandlers() {
            document.querySelectorAll('#reportTable th.sortable-header').forEach(th => {
                th.addEventListener('click', function() {
                    const key = th.dataset.sortKey;
                    if (!key) return;

                    if (currentSort.key === key) {
                        currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                    } else {
                        currentSort.key = key;
                        currentSort.direction = key === 'name' ? 'asc' : 'desc';
                    }

                    if (allData && Object.keys(allData).length > 0) {
                        displayReport(allData);
                    }
                });
            });

            document.querySelectorAll('#reportTable th.reset-sort-header').forEach(th => {
                th.addEventListener('click', function() {
                    resetSort(true);
                });
            });
        }

        function trendClass(v) { return v > 0 ? "trend-up" : (v < 0 ? "trend-down" : "trend-flat"); }
        function trendArrow(v) { return v > 0 ? '&uarr;' : (v < 0 ? '&darr;' : '&rarr;'); }

        function zoneScore(zone) { return zone === "Green" ? 3 : zone === "Yellow" ? 2 : zone === "Red" ? 1 : zone === "New" ? 2 : 0; }

        function createHistorySparkline(history) {
            if (!weeksToShow || weeksToShow.length === 0) return "";
            const values = weeksToShow.map(w => { const e = (history || []).find(h => h.week === w.uniqueIdentifier); return zoneScore(e ? e.zone : ""); });
            const width = 64, height = 16, pad = 1;
            const step = values.length > 1 ? (width - (pad * 2)) / (values.length - 1) : 0;
            const points = values.map((v, i) => `${pad + (i * step)},${height - pad - ((v / 3) * (height - (pad * 2)))}`).join(" ");
            return `<div class="mini-sparkline" title="History trend line (Blue): Green=high, Yellow=medium, Red=low"><svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}"><polyline points="${points}" fill="none" stroke="#0d6efd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>`;
        }
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function openPlayerExplorer(name) {
            if (!name) return;
            const url = `/Report/PlayerExplorer?name=${encodeURIComponent(name)}&embedded=1`;
            const modalEl = document.getElementById('playerExplorerModal');
            const frameEl = document.getElementById('playerExplorerFrame');
            const titleEl = document.getElementById('playerExplorerModalLabel');
            const exportGroupEl = document.getElementById('playerExplorerModalExportGroup');
            if (!modalEl || !frameEl || !titleEl || !window.bootstrap?.Modal) return;

            const applyEmbeddedStyles = () => {
                try {
                    const doc = frameEl.contentDocument;
                    if (!doc) return;

                    const styleId = 'embedded-player-explorer-style';
                    let styleTag = doc.getElementById(styleId);
                    if (!styleTag) {
                        styleTag = doc.createElement('style');
                        styleTag.id = styleId;
                        doc.head.appendChild(styleTag);
                    }

                    styleTag.textContent = `
                        header,
                        footer,
                        #alerts,
                        .explorer-hero,
                        .explorer-controls {
                            display: none !important;
                        }

                        body {
                            background: #f8fafc !important;
                        }

                        main[role="main"] {
                            padding-bottom: 0 !important;
                        }

                        .container.mt-3.explorer-page {
                            margin-top: 0 !important;
                            padding-top: 0.5rem !important;
                        }
                    `;

                    if (exportGroupEl) {
                        exportGroupEl.style.display = 'inline-flex';
                    }
                } catch {
                    // Ignore cross-document styling issues.
                }
            };

            if (!playerExplorerModalInstance) {
                playerExplorerModalInstance = new bootstrap.Modal(modalEl);
                modalEl.addEventListener('hidden.bs.modal', () => {
                    frameEl.src = 'about:blank';
                    if (exportGroupEl) {
                        exportGroupEl.style.display = 'none';
                    }
                });
            }

            titleEl.textContent = `Player Explorer - ${name}`;
            frameEl.onload = applyEmbeddedStyles;
            frameEl.src = url;
            playerExplorerModalInstance.show();
        }

        function populateIgnorePlayers(data) {
            const persistedIgnored = new Set((getSavedState().ignoredPlayers || []).map(x => (x || '').toLowerCase()));
            const currentIgnored = new Set([ ...Array.from(getIgnoredPlayerSet()), ...Array.from(persistedIgnored) ]);
            const names = [
                ...(data.completedBoth || []),
                ...(data.completedOne || []),
                ...(data.failedBoth || []),
                ...(data.recentlyJoined || []),
                ...(data.leftPlayers || [])
            ]
                .map(x => x.name)
                .filter(Boolean)
                .filter((n, i, arr) => arr.findIndex(x => x.toLowerCase() === n.toLowerCase()) === i)
                .sort((a, b) => a.localeCompare(b));

            const menu = document.getElementById('ignorePlayersContainer');
            if (!menu) return;

            let html = `
                <input type="text" class="form-control form-control-sm mb-2 dropdown-search" data-target=".ignore-player-item" placeholder="Search players..." />
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="ignoreSelectAll">
                    <label class="form-check-label" for="ignoreSelectAll">Select All</label>
                </div>
                <hr class="my-2" />`;

            if (names.length === 0) {
                html += `<div class="text-muted small">No players found</div>`;
            } else {
                html += names.map((name, idx) => `
                    <div class="form-check ignore-player-item">
                        <input class="form-check-input ignore-player-filter" type="checkbox" id="ignorePlayer_${idx}" value="${name}" ${currentIgnored.has(name.toLowerCase()) ? 'checked' : ''}>
                        <label class="form-check-label" for="ignorePlayer_${idx}">${name}</label>
                    </div>`).join('');
            }

            menu.innerHTML = html;

            setupSelectAll('ignoreSelectAll', '.ignore-player-filter');
            setupSearchHandlers();


            document.querySelectorAll('.ignore-player-filter').forEach(cb => {
                cb.addEventListener('change', () => {
                    updateAllDropdownButtonTexts();
                    saveState();
                    if (allData && Object.keys(allData).length > 0) displayReport(allData);
                });
            });

            const selectAllIgnore = document.getElementById('ignoreSelectAll');
            if (selectAllIgnore) {
                selectAllIgnore.addEventListener('change', () => {
                    updateAllDropdownButtonTexts();
                    saveState();
                    if (allData && Object.keys(allData).length > 0) displayReport(allData);
                });
            }

            updateAllDropdownButtonTexts();
        }

        function resetFilters() {
            localStorage.removeItem(FILTER_STATE_KEY);

            document.querySelectorAll('.status-filter, .header-filter, .summary-filter').forEach(cb => cb.checked = true);
            const statusAll = document.getElementById('statusSelectAll'); if (statusAll) statusAll.checked = true;
            const headerAll = document.getElementById('headerSelectAll'); if (headerAll) headerAll.checked = true;
            const summaryAll = document.getElementById('summarySelectAll'); if (summaryAll) summaryAll.checked = true;

            const weekDropdown = document.getElementById('weekDropdown');
            if (weekDropdown && weekDropdown.options.length > 0) {
                weekDropdown.selectedIndex = 0;
                currentWeek = weekDropdown.value;
            }

            document.querySelectorAll('.ignore-player-filter').forEach(cb => cb.checked = false);
            const ignoreAll = document.getElementById('ignoreSelectAll'); if (ignoreAll) ignoreAll.checked = false;

            updateAllDropdownButtonTexts();
            saveState();

            if (allData && Object.keys(allData).length > 0) {
                populateIgnorePlayers(allData);
                displayReport(allData);
            }
        }

        async function generateReport() {
            const week = document.getElementById('weekDropdown').value;
            if (!week) return;

            currentWeek = week;
            resetSort(false);

            setButtonLoading('generateReportBtn', true, 'Generating...', 'Generate Report');

            try {
                const selectedResponse = await fetch(`/Report/GenerateReport?week=${encodeURIComponent(week)}`);
                const selectedData = await selectedResponse.json();

                const selectedIndex = availableWeeks.findIndex(w => w.uniqueIdentifier === week);
                let previousData = null;

                if (selectedIndex >= 0 && selectedIndex + 1 < availableWeeks.length) {
                    const prevWeek = availableWeeks[selectedIndex + 1].uniqueIdentifier;
                    const prevResponse = await fetch(`/Report/GenerateReport?week=${encodeURIComponent(prevWeek)}`);
                    if (prevResponse.ok) {
                        previousData = await prevResponse.json();
                    }
                }

                buildPreviousReportMap(previousData);
                allData = selectedData;
                populateIgnorePlayers(selectedData);
                displayReport(selectedData);
            } finally {
                setButtonLoading('generateReportBtn', false, '', 'Generate Report');
            }
        }

        function displayReport(data) {
            const reportTable = document.getElementById('reportTable');
            reportTable.innerHTML = '';
            if (!data) return;

            weeksToShow = data.weeksToShow;
            const col = getColumnVisibility();
            const ignored = getIgnoredPlayerSet();

            const showCompletedBoth = document.getElementById('statusCompletedBoth').checked;
            const showCompletedOne = document.getElementById('statusCompletedOne').checked;
            const showFailedBoth = document.getElementById('statusFailedBoth').checked;
            const showNewPlayers = document.getElementById('statusNewPlayers').checked;
            const showLeftPlayers = document.getElementById('statusLeftPlayers').checked;

            const removeIgnored = rows => rows.filter(r => !ignored.has((r.name || '').toLowerCase()));

            const filteredCompletedBoth = showCompletedBoth ? removeIgnored(data.completedBoth || []) : [];
            const filteredCompletedOne = showCompletedOne ? removeIgnored(data.completedOne || []) : [];
            const filteredFailedBoth = showFailedBoth ? removeIgnored(data.failedBoth || []) : [];
            const filteredRecentlyJoined = showNewPlayers ? removeIgnored(data.recentlyJoined || []) : [];
            const filteredLeftPlayers = showLeftPlayers ? removeIgnored(data.leftPlayers || []) : [];

            const rowsWithStyle = [
                ...filteredCompletedBoth.map(r => ({ ...r, __bg: '#e6ffed' })),
                ...filteredCompletedOne.map(r => ({ ...r, __bg: '#fff9db' })),
                ...filteredFailedBoth.map(r => ({ ...r, __bg: '#ffebee' })),
                ...filteredRecentlyJoined.map(r => ({ ...r, __bg: '#f0f0f0' })),
                ...filteredLeftPlayers.map(r => ({ ...r, __bg: '#e0e0e0' }))
            ];

            const searchedRows = !reportSearchTerm
                ? rowsWithStyle
                : rowsWithStyle.filter(r => (r.name || '').toLowerCase().includes(reportSearchTerm));

            searchedRows.sort((a, b) => {
                const result = compareRows(a, b, currentSort.key);
                return currentSort.direction === 'asc' ? result : -result;
            });

            let table = `
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            ${col.name ? `<th class="sortable-header" data-sort-key="name">Name${sortIndicator('name')}</th>` : ''}
                            ${col.kills ? `<th class="sortable-header" data-sort-key="killsDiff">Kills (%)${sortIndicator('killsDiff')}</th>` : ''}
                            ${col.edm ? `<th class="sortable-header" data-sort-key="edmDiff">EDM${sortIndicator('edmDiff')}</th>` : ''}
                            ${col.troopsLost ? `<th class="sortable-header" data-sort-key="troopsLostDiff">Troops Lost${sortIndicator('troopsLostDiff')}</th>` : ''}
                            ${col.hunt ? `<th class="sortable-header" data-sort-key="huntPoints">Hunt (%)${sortIndicator('huntPoints')}</th>` : ''}
                            ${col.purchase ? `<th class="sortable-header" data-sort-key="purchasePoints">Purchase${sortIndicator('purchasePoints')}</th>` : ''}
                            ${col.history ? `<th class="sortable-header" data-sort-key="history">History${sortIndicator('history')}</th>` : ''}
                        </tr>
                    </thead>
                    <tbody>`;

            let serialNumber = 1;

            const createHistoryCells = (history) => {
                if (!history || history.length === 0) return '<td></td>';
                let cells = '';
                weeksToShow.forEach(week => {
                    const entry = history.find(h => h.week === week.uniqueIdentifier);
                    const zone = entry ? entry.zone : '';
                    let colorClass = '';
                    if (zone === 'Green') colorClass = 'green';
                    else if (zone === 'Yellow') colorClass = 'yellow';
                    else if (zone === 'Red') colorClass = 'red';
                    else if (zone === 'New') colorClass = 'new';
                    else if (zone === 'Left') colorClass = 'left';
                    cells += `<span class="heatmap-cell ${colorClass}" title="${week.fromDate} - ${week.toDate}: ${zone}"></span>`;
                });
                const graph = col.historyGraph ? createHistorySparkline(history) : '';
                return `<td class="heatmap-container">${cells}${graph}</td>`;
            };

            const formatPercentage = (value) => Math.round(value) + '%';

            const editableCellHtml = (row, field, rawValue, displayHtml) => {
                if (rawValue === null || rawValue === undefined) {
                    return `<td>${displayHtml}</td>`;
                }

                return `<td class="editable-cell" data-user-id="${row.userId}" data-field="${field}" data-raw-value="${escapeHtml(rawValue)}" title="Double-click to edit">${displayHtml}</td>`;
            };

            const trendByPrevious = (row, field) => {
                if (!col.historyIndicators) return '';
                const previous = previousReportMap.get(getRowKey(row));
                if (!previous) {
                    return ` <span class="trend-flat">${trendArrow(0)}</span>`;
                }
                const diff = Number(row[field] || 0) - Number(previous[field] || 0);
                return ` <span class="${trendClass(diff)}">${trendArrow(diff)}</span>`;
            };

            const formatRow = (row, bgColor) => {
                const formatDiff = (value, percentage, isGood) => {
                    if (row.isNewPlayer || row.hasLeft) return '-';
                    const trendHtml = trendByPrevious(row, 'killsDiff');
                    return `${value.toLocaleString()} <span class="${isGood ? 'highlight-green' : 'highlight-red'}">&nbsp;(${formatPercentage(percentage)})</span>${trendHtml}`;
                };
                const formatDiff2 = (value, percentage, isGood) => {
                    const trendHtml = trendByPrevious(row, 'huntPoints');
                    return `${value.toLocaleString()} <span class="${isGood ? 'highlight-green' : 'highlight-red'}">&nbsp;(${formatPercentage(percentage)})</span>${trendHtml}`;
                };

                return `
                    <tr style="background-color: ${bgColor}">
                        <td>${serialNumber++}</td>
                        ${col.name ? `<td><button type="button" class="player-link" data-player-name="${encodeURIComponent(row.name || '')}" onclick="openPlayerExplorer(decodeURIComponent(this.dataset.playerName || ''))">${escapeHtml(row.name)}</button></td>` : ''}
                        ${col.kills ? (row.isNewPlayer || row.hasLeft ? `<td>-</td>` : editableCellHtml(row, 'killsDiff', row.killsDiff, formatDiff(row.killsDiff, row.killsPercentage, row.killsPercentage >= 100))) : ''}
                        ${col.edm ? (row.isNewPlayer || row.hasLeft ? `<td>-</td>` : editableCellHtml(row, 'edmDiff', row.edmDiff, `${row.edmDiff.toLocaleString()}${trendByPrevious(row, 'edmDiff')}`)) : ''}
                        ${col.troopsLost ? (row.isNewPlayer || row.hasLeft ? `<td>-</td>` : editableCellHtml(row, 'troopsLostDiff', row.troopsLostDiff, `${row.troopsLostDiff.toLocaleString()}${trendByPrevious(row, 'troopsLostDiff')}`)) : ''}
                        ${col.hunt ? editableCellHtml(row, 'huntPoints', row.huntPoints, formatDiff2(row.huntPoints, row.huntPercentage, row.huntPercentage >= 100)) : ''}
                        ${col.purchase ? editableCellHtml(row, 'purchasePoints', row.purchasePoints, `${row.purchasePoints.toLocaleString()}${trendByPrevious(row, 'purchasePoints')}`) : ''}
                        ${col.history ? `${createHistoryCells(row.history)}` : ''}
                    </tr>`;
            };

            searchedRows.forEach(r => table += formatRow(r, r.__bg));

            table += `</tbody></table>`;
            reportTable.innerHTML = table;
            bindSortHandlers();
            bindInlineEditHandlers();

            showTopPerformers(data.topPerformers, ignored);
            if (isDataInsightsEnabled()) {
                renderDataInsights(data, ignored);
            } else {
                const insights = document.getElementById('dataInsights');
                if (insights) insights.innerHTML = '';
            }
            document.getElementById('exportGroup').style.display = 'inline-flex';
        }

        function renderDataInsights(data, ignoredSet) {
            const container = document.getElementById('dataInsights');
            if (!container) return;
            container.innerHTML = '';
            if (!data) return;

            const ignored = ignoredSet || getIgnoredPlayerSet();
            const allRows = [
                ...(data.completedBoth || []),
                ...(data.completedOne || []),
                ...(data.failedBoth || []),
                ...(data.recentlyJoined || []),
                ...(data.leftPlayers || [])
            ].filter(r => !ignored.has((r.name || '').toLowerCase()));

            const active = allRows.filter(r => !r.isNewPlayer && !r.hasLeft);
            const totalKills = active.reduce((s, r) => s + (r.killsDiff || 0), 0);
            const totalHunt = active.reduce((s, r) => s + (r.huntPoints || 0), 0);
            const greenCount = (data.completedBoth || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length;
            const yellowCount = (data.completedOne || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length;
            const redCount = (data.failedBoth || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length;

            const cards = [
                { label: 'Total Players', value: allRows.length, color: 'primary' },
                { label: 'Total Kills (Week)', value: totalKills.toLocaleString(), color: 'success' },
                { label: 'Total Hunt Pts', value: totalHunt.toLocaleString(), color: 'info' },
                { label: 'Green / Yellow / Red', value: `${greenCount} / ${yellowCount} / ${redCount}`, color: 'secondary' }
            ];

            cards.forEach(c => {
                const col = document.createElement('div');
                col.className = 'col-6 col-md-3';
                col.innerHTML = `<div class="card text-center p-2"><div class="text-muted small">${c.label}</div><div class="fw-bold fs-5 text-${c.color}">${c.value}</div></div>`;
                container.appendChild(col);
            });
        }

        function showTopPerformers(topPerformers, ignoredSet) {
            const container = document.getElementById('topPerformers');
            if (!container) return;
            container.innerHTML = '';
            if (!topPerformers) return;
            const ignored = ignoredSet || getIgnoredPlayerSet();
            const selectedCats = getSelectedSummaryCategories();
            selectedCats.forEach(cat => {
                const items = (topPerformers[cat.key] || []).filter(i => !ignored.has((i.name || '').toLowerCase())).slice(0, 5);
                if (items.length === 0) return;
                const col = document.createElement('div');
                col.className = 'col-12 col-md-6 col-lg-3';
                const rowsHtml = items.map((item, idx) => `<tr><td>${idx+1}</td><td>${item.name}</td><td class="text-end fw-bold">${(item[cat.valueField]||0).toLocaleString()} <small class="text-muted">${cat.suffix}</small></td></tr>`).join('');
                col.innerHTML = `<div class="card h-100"><div class="card-header fw-semibold">${cat.title}</div><div class="card-body p-0"><table class="table table-sm table-hover mb-0"><tbody>${rowsHtml}</tbody></table></div></div>`;
                container.appendChild(col);
            });
        }

        async function generateJPG() {
            const reportTable = document.getElementById('reportTable').querySelector('table');
            if (!reportTable) return;

            setButtonLoading('jpgButton', true, 'Exporting...','Export JPG');

            const exportRoot = document.createElement('div');
            exportRoot.style.background = '#fff';
            exportRoot.style.padding = '16px';
            exportRoot.style.width = '1200px';
            exportRoot.style.position = 'fixed';
            exportRoot.style.left = '-10000px';
            exportRoot.style.top = '0';

            const selectedWeek = document.getElementById('weekDropdown').selectedOptions[0]?.text || '';
            const title = document.createElement('div');
            title.style.fontSize = '20px';
            title.style.fontWeight = '600';
            title.textContent = `@@DR Stats Report: ${selectedWeek}`;

            const subtitle = document.createElement('div');
            subtitle.style.marginBottom = '12px';
            subtitle.style.color = '#666';
            subtitle.style.fontSize = '12px';
            subtitle.textContent = `Created by: DigTank | Generated on: ${new Date().toLocaleDateString()}`;

            exportRoot.appendChild(title);
            exportRoot.appendChild(subtitle);
            if (isDataInsightsEnabled()) {
                const insights = document.getElementById('dataInsights');
                if (insights && insights.children.length > 0) {
                    exportRoot.appendChild(insights.cloneNode(true));
                }
            }
            const tableClone = reportTable.cloneNode(true);
            tableClone.querySelectorAll('tbody td').forEach(td => {
                td.style.padding = '0.22rem 0.38rem';
                td.style.lineHeight = '1.1';
                td.style.verticalAlign = 'middle';
            });
            exportRoot.appendChild(tableClone);
            exportRoot.appendChild(document.getElementById('heatmapLegend').cloneNode(true));
            exportRoot.appendChild(document.getElementById('topPerformers').cloneNode(true));
            document.body.appendChild(exportRoot);

            const canvas = await html2canvas(exportRoot, { scale: 3, backgroundColor: '#ffffff', useCORS: true });
            const link = document.createElement('a');
            const dateRange = selectedWeek.replace(/ /g, '_').replace(/-/g, '');
            link.download = `DR_Weekly_Report_${dateRange}.jpg`;
            link.href = canvas.toDataURL('image/jpeg', 0.98);
            link.click();

            document.body.removeChild(exportRoot);
            setButtonLoading('jpgButton', false, '','Export JPG');
        }

        function generatePDF() {
            const reportTable = document.getElementById('reportTable').querySelector('table');
            if (!reportTable) return;

            setButtonLoading('pdfButton', true, 'Exporting...', 'Export PDF');

            const { jsPDF } = window.jspdf;
            const rowCount = reportTable.querySelectorAll('tbody tr').length;
            const summaryRows = Math.ceil(getSelectedSummaryCategories().length / 2);
            const estimatedHeight = Math.max(297, 130 + (isDataInsightsEnabled() ? 16 : 0) + (rowCount * 6) + (summaryRows * 45));
            const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: [210, estimatedHeight] });
            const ignored = getIgnoredPlayerSet();

            const STYLE = {
                colors: {
                    green: [40, 167, 69], yellow: [255, 193, 7], red: [220, 53, 69], blue: [23, 162, 184], gray: [108, 117, 125], white: [255, 255, 255],
                    lightGreen: [230, 255, 237], lightYellow: [255, 249, 219], lightRed: [255, 235, 238], lightGray: [240, 240, 240],
                    cardBg: [240, 240, 240], legendBg: [245, 245, 245], border: [220, 220, 220], textDark: [60, 60, 60], textMedium: [80, 80, 80],
                    pcardBg: [103, 150, 243], cardText: [255, 255, 255]
                },
                tableBox: { width: 3, height: 3, radius: 0.7, spacing: 4 },
                legendBox: { size: 4, radius: 1, textOffset: 5 },
                card: { width: 88, height: 35, padding: 4, margin: 3 }
            };

            const selectedWeek = document.getElementById('weekDropdown').selectedOptions[0].text;
            doc.setFontSize(12);
            doc.text(`@@DR Stats Report: ${selectedWeek}`, 14, 10);
            doc.setFontSize(9);
            doc.setTextColor(100, 100, 100);
            doc.setFont(undefined, 'italic');
            doc.text('Created by: DigTank', 14, 14);
            doc.setFont(undefined, 'normal');
            doc.text(`Generated on: ${new Date().toLocaleDateString()}`, doc.internal.pageSize.getWidth() - 14, 14, { align: 'right' });
            doc.setFont(undefined, 'normal');

            const headers = Array.from(reportTable.querySelectorAll('thead th')).map(th => th.innerText);
            const historyColumnIndex = headers.indexOf('History');
            const rows = [];

            Array.from(reportTable.querySelectorAll('tbody tr')).forEach(row => {
                const rowData = Array.from(row.querySelectorAll('td')).map((cell, index) => {
                    if (index === historyColumnIndex) return cell;
                    return cell.innerText
                        .replace(/\n/g, ' ')
                        .replace(/↑/g, '^')
                        .replace(/↓/g, 'v')
                        .replace(/→/g, '>')
                        .trim();
                });
                rows.push(rowData);
            });

            let tableStartY = 20;
            if (isDataInsightsEnabled()) {
                const allRows = [
                    ...(allData.completedBoth || []),
                    ...(allData.completedOne || []),
                    ...(allData.failedBoth || []),
                    ...(allData.recentlyJoined || []),
                    ...(allData.leftPlayers || [])
                ].filter(r => !ignored.has((r.name || '').toLowerCase()));
                const activeRows = allRows.filter(r => !r.isNewPlayer && !r.hasLeft);
                const totalKills = activeRows.reduce((s, r) => s + (r.killsDiff || 0), 0);
                const totalHunt = activeRows.reduce((s, r) => s + (r.huntPoints || 0), 0);
                const greenCount = (allData.completedBoth || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length;
                const yellowCount = (allData.completedOne || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length;
                const redCount = (allData.failedBoth || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length;

                const insightsY = 18;
                doc.setFillColor(...STYLE.colors.legendBg);
                doc.rect(14, insightsY, doc.internal.pageSize.width - 28, 10, 'F');
                doc.setDrawColor(...STYLE.colors.border);
                doc.rect(14, insightsY, doc.internal.pageSize.width - 28, 10, 'S');
                doc.setFontSize(8.5);
                doc.setTextColor(...STYLE.colors.textDark);
                doc.text(`Total Players: ${allRows.length}`, 17, insightsY + 6.5);
                doc.text(`Total Kills: ${totalKills.toLocaleString()}`, 58, insightsY + 6.5);
                doc.text(`Total Hunt Pts: ${totalHunt.toLocaleString()}`, 99, insightsY + 6.5);
                doc.text(`Green/Yellow/Red: ${greenCount}/${yellowCount}/${redCount}`, 142, insightsY + 6.5);
                tableStartY = 31;
            }

            const baseColumnWidths = { '#': 8, 'Name': 25, 'Kills (%)': 30, 'EDM': 30, 'Troops Lost': 25, 'Hunt (%)': 20, 'Purchase': 20, 'History': 25 };
            const selectedBaseWidths = headers.map(h => baseColumnWidths[h] ?? 20);
            const totalBaseWidth = selectedBaseWidths.reduce((sum, w) => sum + w, 0);
            const availableWidth = doc.internal.pageSize.getWidth() - 28;
            const scale = totalBaseWidth > 0 ? (availableWidth / totalBaseWidth) : 1;

            const columnStyles = {};
            headers.forEach((header, index) => {
                const scaledWidth = Math.max(8, (baseColumnWidths[header] ?? 20) * scale);
                columnStyles[index] = { cellWidth: scaledWidth };
            });

            doc.autoTable({
                head: [headers],
                body: rows,
                startY: tableStartY,
                theme: 'grid',
                styles: { fontSize: 8, cellPadding: 1, overflow: 'linebreak', textColor: STYLE.colors.textDark, lineColor: STYLE.colors.border, lineWidth: 0.1 },
                headerStyles: { fontSize: 9, cellPadding: 2, fillColor: STYLE.colors.cardBg, textColor: STYLE.colors.textDark, lineColor: STYLE.colors.border, lineWidth: 0.1 },
                columnStyles,
                margin: { top: 15 },
                didParseCell: (data) => {
                    if (data.section === 'head') return;
                    const rowIndex = data.row.index;
                    const completedBothCount = document.getElementById('statusCompletedBoth').checked ? (allData.completedBoth || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length : 0;
                    const completedOneCount = document.getElementById('statusCompletedOne').checked ? (allData.completedOne || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length : 0;
                    const failedBothCount = document.getElementById('statusFailedBoth').checked ? (allData.failedBoth || []).filter(r => !ignored.has((r.name || '').toLowerCase())).length : 0;
                    if (rowIndex < completedBothCount) data.cell.styles.fillColor = STYLE.colors.lightGreen;
                    else if (rowIndex < completedBothCount + completedOneCount) data.cell.styles.fillColor = STYLE.colors.lightYellow;
                    else if (rowIndex < completedBothCount + completedOneCount + failedBothCount) data.cell.styles.fillColor = STYLE.colors.lightRed;
                    else data.cell.styles.fillColor = STYLE.colors.lightGray;
                },
                didDrawCell: (data) => {
                    if (historyColumnIndex >= 0 && data.column.index === historyColumnIndex && data.cell.raw && data.cell.raw.querySelectorAll) {
                        const boxes = Array.from(data.cell.raw.querySelectorAll('span'));
                        let xPos = data.cell.x + 1;
                        const yPos = data.cell.y + (data.cell.height - STYLE.tableBox.height) / 2;
                        boxes.forEach(box => {
                            const colorClass = box.className.includes('green') ? 'green' : box.className.includes('yellow') ? 'yellow' : box.className.includes('red') ? 'red' : box.className.includes('new') ? 'blue' : box.className.includes('left') ? 'gray' : 'white';
                            doc.setFillColor(...STYLE.colors[colorClass]);
                            doc.roundedRect(xPos, yPos, STYLE.tableBox.width, STYLE.tableBox.height, STYLE.tableBox.radius, STYLE.tableBox.radius, 'F');
                            xPos += STYLE.tableBox.spacing;
                        });
                    }
                }
            });

            const legendY = doc.lastAutoTable.finalY + 5;
            doc.setFillColor(...STYLE.colors.legendBg);
            doc.rect(14, legendY, doc.internal.pageSize.width - 28, 10, 'F');
            doc.setDrawColor(...STYLE.colors.border);
            doc.rect(14, legendY, doc.internal.pageSize.width - 28, 10, 'S');

            doc.setFontSize(8);
            doc.setTextColor(...STYLE.colors.textMedium);
            doc.text('Goals Legend:', 18, legendY + 6);

            const legendItems = [
                { color: 'green', label: 'Completed Both' }, { color: 'yellow', label: 'Completed One' }, { color: 'red', label: 'Failed Both' }, { color: 'blue', label: 'New Player' }, { color: 'gray', label: 'Left Player' }
            ];

            let xLegend = 40;
            legendItems.forEach(item => {
                doc.setFillColor(...STYLE.colors[item.color]);
                doc.roundedRect(xLegend, legendY + 3, STYLE.legendBox.size, STYLE.legendBox.size, STYLE.legendBox.radius, STYLE.legendBox.radius, 'F');
                doc.setTextColor(...STYLE.colors.textDark);
                doc.text(item.label, xLegend + STYLE.legendBox.textOffset, legendY + 6);
                xLegend += doc.getTextWidth(item.label) + 10;
            });

            if (allData.topPerformers) {
                const pageHeight = doc.internal.pageSize.getHeight();
                const cardWidth = STYLE.card.width;
                const cardHeight = STYLE.card.height;
                const cardGap = STYLE.card.margin;
                let yPos = doc.lastAutoTable.finalY + 32;
                let col = 0;

                const categories = getSelectedSummaryCategories().map(c => ({
                    title: c.title,
                    items: (allData.topPerformers[c.key] || []).filter(i => !ignored.has((i.name || '').toLowerCase())).slice(0, 3),
                    valueField: c.valueField,
                    suffix: c.suffix
                }));

                if (yPos + cardHeight > pageHeight - 10) {
                    doc.addPage();
                    yPos = 20;
                }

                doc.setFontSize(10);
                doc.text('Top Performers', 14, yPos - 5);

                categories.forEach(category => {
                    if (yPos + cardHeight > pageHeight - 10) {
                        doc.addPage();
                        yPos = 20;
                        col = 0;
                        doc.setFontSize(10);
                        doc.text('Top Performers', 14, yPos - 5);
                    }

                    const xPos = 15 + (col * (cardWidth + cardGap));
                    doc.setFillColor(...STYLE.colors.pcardBg);
                    doc.roundedRect(xPos, yPos, cardWidth, cardHeight, 3, 3, 'F');

                    doc.setFontSize(10);
                    doc.setTextColor(...STYLE.colors.cardText);
                    doc.text(category.title, xPos + STYLE.card.padding, yPos + STYLE.card.padding + 5);

                    category.items.forEach((item, itemIndex) => {
                        const itemY = yPos + STYLE.card.padding + 10 + (itemIndex * 6);
                        doc.setFontSize(9);
                        doc.text(`${itemIndex + 1}. ${item.name}`, xPos + STYLE.card.padding + 5, itemY);
                        doc.text(`${item[category.valueField].toLocaleString()} ${category.suffix}`, xPos + cardWidth - STYLE.card.padding - 5, itemY, { align: 'right' });
                    });

                    col++;
                    if (col === 2) {
                        col = 0;
                        yPos += cardHeight + cardGap;
                    }
                });
            }

            const dateRange = selectedWeek.replace(/ /g, '_').replace(/-/g, '');
            doc.save(`DR_Weekly_Report_${dateRange}.pdf`);
            setButtonLoading('pdfButton', false, '', 'Export PDF');
        }
    </script>
}
