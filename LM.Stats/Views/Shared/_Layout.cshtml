<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LM.Stats</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker@3.1.0/daterangepicker.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="app-shell">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3 top-nav-shell">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">LM.Stats</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="topNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Report" asp-action="Index">Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Report" asp-action="PlayerExplorer">Player Explorer</a>
                        </li>
                    </ul>

                    <div class="d-flex flex-wrap gap-2">
                        <button id="importBtn" class="btn btn-primary btn-sm">Import from Files (CSV/XLSX)</button>
                        <button id="rollbackBtn" class="btn btn-outline-danger btn-sm">Reset/Delete Uploaded Report</button>
                        @* <button id="backupBtn" class="btn btn-secondary btn-sm">Backup to Google Drive</button>
                        <button id="syncBtn" class="btn btn-info btn-sm">Sync from Google Drive</button> *@
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <div id="alerts"></div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Import Modal -->
    <div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="importModalLabel">Import Report Files</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="importForm">
                        <div class="mb-3">
                            <label for="huntFileInput" class="form-label">Hunt File</label>
                            <input type="file" class="form-control" id="huntFileInput" accept=".csv,.xlsx" />
                            <div class="form-text">Supported formats: CSV, XLSX</div>
                        </div>
                        <div class="mb-3">
                            <label for="killsFileInput" class="form-label">Kills File</label>
                            <input type="file" class="form-control" id="killsFileInput" accept=".csv,.xlsx" />
                            <div class="form-text">Supported formats: CSV, XLSX</div>
                        </div>

                        <div id="fileValidationStatus" class="alert alert-secondary small d-none mb-3"></div>

                        <div class="mb-3">
                            <label for="dateRange" class="form-label">Date Range</label>
                            <input type="text" class="form-control daterange" id="dateRange" name="dateRange" disabled>
                        </div>

                        <div class="mb-0">
                            <label for="uniqueId" class="form-label">Unique Identifier</label>
                            <input type="text" class="form-control" id="uniqueId" name="uniqueId" readonly>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="submitImport" disabled>Upload Report</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rollbackModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Uploaded Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning py-2">
                        This will permanently delete the selected uploaded report and all related processed data.
                    </div>
                    <div class="mb-0">
                        <label for="rollbackReportDropdown" class="form-label">Select Uploaded Report</label>
                        <select id="rollbackReportDropdown" class="form-select">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteReport">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Modals -->
    <div class="modal fade" id="confirmBackupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Backup</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to backup the database to Google Drive?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmBackup">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirmSyncModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Sync</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to sync database from Google Drive? This will replace your current database.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmSync">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - LM.Stats
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker@3.1.0/daterangepicker.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>